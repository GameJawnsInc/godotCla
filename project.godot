config_version=5

[application]

config/name="TENDER"
config/icon="res://icon.png"
run/main_scene="res://shell/main.tscn"
config/features=PackedStringArray("4.7")
; Android's Back button must not kill the app: the shell handles
; NOTIFICATION_WM_GO_BACK_REQUEST itself (shell/main.gd _notification -> _back),
; where Back means "up one level" and only quits at the menu.
config/quit_on_go_back=false

[display]

window/size/viewport_width=920
window/size/viewport_height=1680
window/stretch/mode="disabled"
window/handheld/orientation=5

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0.066, 0.086, 0.1, 1)
textures/vram_compression/import_etc2_astc=true
